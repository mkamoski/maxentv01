@page "/readme"
@using Markdig

<PageTitle>README - MaxEnt</PageTitle>

<div class="readme-container">
    @if (_html is not null)
    {
        @((MarkupString)_html)
    }
    else
    {
        <p><em>Loading README…</em></p>
    }
</div>

<style>
    .readme-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 1.5rem;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        line-height: 1.6;
        color: #24292e;
    }

    .readme-container h1,
    .readme-container h2,
    .readme-container h3,
    .readme-container h4 {
        border-bottom: 1px solid #e1e4e8;
        padding-bottom: 0.3em;
        margin-top: 1.5em;
    }

    .readme-container code {
        background: #f6f8fa;
        padding: 0.2em 0.4em;
        border-radius: 3px;
        font-size: 85%;
        font-family: "Consolas", "Monaco", monospace;
    }

    .readme-container pre {
        background: #f6f8fa;
        border: 1px solid #e1e4e8;
        border-radius: 6px;
        padding: 1rem;
        overflow-x: auto;
    }

    .readme-container pre code {
        background: none;
        padding: 0;
        font-size: 90%;
    }

    .readme-container table {
        border-collapse: collapse;
        width: 100%;
        margin: 1rem 0;
    }

    .readme-container th,
    .readme-container td {
        border: 1px solid #e1e4e8;
        padding: 0.5rem 0.75rem;
        text-align: left;
    }

    .readme-container th {
        background: #f6f8fa;
        font-weight: 600;
    }

    .readme-container tr:nth-child(even) td {
        background: #fafbfc;
    }

    .readme-container blockquote {
        border-left: 4px solid #e1e4e8;
        color: #6a737d;
        margin: 0;
        padding: 0 1em;
    }

    .readme-container a {
        color: #0366d6;
        text-decoration: none;
    }

    .readme-container a:hover {
        text-decoration: underline;
    }

    .readme-container hr {
        border: none;
        border-top: 1px solid #e1e4e8;
        margin: 1.5rem 0;
    }
</style>

@code {
    private string? _html;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var stream = await FileSystem.OpenAppPackageFileAsync("README.md");
            using var reader = new StreamReader(stream);
            var markdown = await reader.ReadToEndAsync();

            var pipeline = new MarkdownPipelineBuilder()
                .UseAdvancedExtensions()
                .Build();

            _html = Markdown.ToHtml(markdown, pipeline);
        }
        catch (Exception ex)
        {
            _html = $"<p><strong>Could not load README:</strong> {System.Net.WebUtility.HtmlEncode(ex.Message)}</p>";
        }
    }
}
