@page "/experiment-results"
@inject IExperimentLogRepository LogRepo
@inject IFileDownloadService FileDownload
@inject IJSRuntime JS

<h2>Experiment Results</h2>

<button @onclick="RefreshAsync">Refresh</button>

<div style="margin-top:10px;"></div>

@if (_summaries.Count == 0)
{
    <p>No results saved yet. Run an experiment and click Save Log.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th style="font-family:Consolas,monospace;font-size:10pt;">Source</th>
                <th style="font-family:Consolas,monospace;font-size:10pt;">Started</th>
                <th style="font-family:Consolas,monospace;font-size:10pt;">Finished</th>
                <th style="font-family:Consolas,monospace;font-size:10pt;">Elapsed</th>
                <th style="font-family:Consolas,monospace;font-size:10pt;">Rows</th>
                <th style="font-family:Consolas,monospace;font-size:10pt;">Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in _summaries)
            {
                var started  = ParseIso(s.StartedTime);
                var finished = ParseIso(s.FinishedTime);
                var elapsed  = started.HasValue && finished.HasValue
                    ? finished.Value - started.Value
                    : (TimeSpan?)null;
                <tr>
                    <td style="font-family:Consolas,monospace;font-size:10pt;">@s.Source</td>
                    <td style="font-family:Consolas,monospace;font-size:10pt;">@(started.HasValue  ? Local(started.Value).ToString("yyyy-MM-dd HH:mm:ss") : "")</td>
                    <td style="font-family:Consolas,monospace;font-size:10pt;">@(finished.HasValue ? Local(finished.Value).ToString("yyyy-MM-dd HH:mm:ss") : "")</td>
                    <td style="font-family:Consolas,monospace;font-size:10pt;">@(elapsed.HasValue  ? elapsed.Value.ToString(@"hh\:mm\:ss\.fff") : "")</td>
                    <td style="font-family:Consolas,monospace;font-size:10pt;">@s.RowCount</td>
                    <td style="font-family:Consolas,monospace;font-size:10pt;">
                        @if (s.Status == ExperimentRunStatus.Incomplete)
                        {
                            <span style="background:#dc3545;color:#fff;font-size:10pt;padding:1px 5px;border-radius:3px;">Incomplete</span>
                        }
                        else
                        {
                            <span style="color:#198754;font-size:10pt;">Completed</span>
                        }
                    </td>
                    <td>
                        <button @onclick="() => DownloadAsync(s.Id, s.Source, s.CreatedAt)">Download</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<ExperimentLogSummary> _summaries = [];
    private int _offsetMinutes;

    protected override async Task OnInitializedAsync()
    {
        var module = await JS.InvokeAsync<IJSObjectReference>("import", "./file-download.js");
        _offsetMinutes = await module.InvokeAsync<int>("getBrowserUtcOffsetMinutes");
        await RefreshAsync();
    }

    private DateTime Local(DateTime utc) => utc.AddMinutes(_offsetMinutes);

    private static DateTime? ParseIso(string? s) =>
        DateTime.TryParse(s, null, System.Globalization.DateTimeStyles.RoundtripKind, out var dt)
            ? dt
            : null;

    private async Task RefreshAsync()
    {
        _summaries = await LogRepo.GetSummariesAsync();
    }

    private async Task DownloadAsync(Guid id, string source, DateTime createdAt)
    {
        var log = await LogRepo.GetByIdAsync(id);
        if (log is null) return;
        var localTime = Local(createdAt);
        var shortSource = source.Replace("MaxEnt", string.Empty);
        var fileName = $"MaxEnt_{shortSource}_{localTime:yyyy_MM_dd_HHmm_ss_fffff}.csv";
        await FileDownload.DownloadTextAsync(log.Content, fileName);
    }
}
