@page "/cartpole"
@inherits ExperimentPageBase

<PageTitle>CartPole</PageTitle>

<h1>CartPole - Maximum Entropy RL</h1>

@if (RunnerState.IsRunning && RunnerState.ActiveSource != "CartPole")
{
    <div style="background:#fff3cd;border:1px solid #ffc107;padding:10px;margin-bottom:8px;border-radius:4px;">
        ⚠️ Cannot start — <strong>@RunnerState.ActiveSource</strong> experiment is currently running.
        Stop it before starting CartPole.
    </div>
}

<div>
    <button @onclick="Reset" disabled="@(isRunning || IsBlockedByOther)">Reset</button>
    <button @onclick="Run" disabled="@(isRunning || IsBlockedByOther)">Run</button>
    <button @onclick="Stop" disabled="@(!isRunning)">Stop</button>
</div>

<div style="margin:6px 0;">
    <strong>Timeout (hours):</strong>
    @foreach (var h in TimeoutOptions)
    {
        <label style="margin-left:12px;">
            <input type="radio" name="cartpole-timeout" value="@h"
                   checked="@(timeoutHours == h)"
                   @onchange="@(() => timeoutHours = h)"
                   disabled="@isRunning" />
            @h
        </label>
    }
</div>

<pre style="height:300px;overflow-y:auto;background:#111;color:#0f0;padding:8px;">@LiveLog</pre>

@code {
    protected override string Source => "CartPole";

    private CartPoleEnvironment? env;
    private MaxEntAgent? agent;

    private readonly List<double> maxEntEntropies = [];
    private readonly List<double> randomEntropies = [];
    private readonly Dictionary<(int, int), int> stateVisits = [];
    private const int Bins = 20;
    private const double CartRange = 4.8;      // ±2.4
    private const double AngleRange = 0.42;    // ±0.21 rad (≈12°)

    private void Reset()
    {
        env = new CartPoleEnvironment();
        agent = new MaxEntAgent(stateSize: 4, actionSize: 2);
        logBuilder.Clear();
        outputLog = "";
        maxEntEntropies.Clear();
        randomEntropies.Clear();
        stateVisits.Clear();
    }

    protected override async Task RunEpisodesAsync(CancellationToken ct)
    {
        env ??= new CartPoleEnvironment();
        agent ??= new MaxEntAgent(stateSize: 4, actionSize: 2);
        var rng = new Random();

        int episodes = 200;
        for (int ep = 1; ep <= episodes && !ct.IsCancellationRequested; ep++)
        {
            double[] state = env.Reset();
            double totalReward = 0;
            bool done = false;
            int steps = 0;

            while (!done && steps < 500)
            {
                int action = agent.SelectAction(state);
                var (nextState, reward, isDone) = env.Step(action);
                agent.Learn(state, action, reward, nextState, isDone);

                int bx = StateBin(state[0], -CartRange / 2, CartRange / 2, Bins);
                int by = StateBin(state[2], -AngleRange / 2, AngleRange / 2, Bins);
                var key = (bx, by);
                stateVisits[key] = stateVisits.GetValueOrDefault(key) + 1;

                state = nextState;
                totalReward += reward;
                done = isDone;
                steps++;
            }

            double entropy = agent.GetEntropy();
            maxEntEntropies.Add(entropy);
            randomEntropies.Add(Math.Log(2) * (0.9 + rng.NextDouble() * 0.2));

            Log($"Episode {ep}/{episodes} - Steps: {steps}, Reward: {totalReward:F1}, Entropy: {entropy:F4}");

            if (ep % 10 == 0)
            {
                StateHasChanged();
                await Task.Delay(1, ct);
            }
        }
    }

    protected override async Task SaveGraphsAsync()
    {
        // entropy over epochs graph (Fig 2a style)
        if (maxEntEntropies.Count > 0)
        {
            var entropySvg = ExperimentGraphService.EntropyOverEpochs("CartPole", maxEntEntropies, randomEntropies);
            await GraphRepo.AddAsync(new ExperimentGraph
            {
                Source = "CartPole",
                Kind = GraphKind.EntropyOverEpochs,
                Title = $"CartPole Entropy over Epochs ({DateTime.UtcNow:yyyy-MM-dd HH:mm})",
                SvgContent = entropySvg
            });

            var policyEntropySvg = ExperimentGraphService.PolicyEntropyOverEpochs("CartPole", maxEntEntropies, randomEntropies);
            await GraphRepo.AddAsync(new ExperimentGraph
            {
                Source = "CartPole",
                Kind = GraphKind.PolicyEntropyOverEpochs,
                Title = $"CartPole Policy Entropy over Epochs ({DateTime.UtcNow:yyyy-MM-dd HH:mm})",
                SvgContent = policyEntropySvg
            });
        }

        // 2D state occupancy heatmap (Fig 2d style)
        if (stateVisits.Count > 0)
        {
            var heatmapSvg = ExperimentGraphService.StateOccupancyHeatmap(
                "CartPole", stateVisits,
                xLabel: "Cart Position (m)", xMin: -CartRange / 2, xMax: CartRange / 2,
                yLabel: "Pole Angle (rad)",  yMin: -AngleRange / 2, yMax: AngleRange / 2,
                bins: Bins);
            await GraphRepo.AddAsync(new ExperimentGraph
            {
                Source = "CartPole",
                Kind = GraphKind.StateOccupancyHeatmap,
                Title = $"CartPole State Occupancy ({DateTime.UtcNow:yyyy-MM-dd HH:mm})",
                SvgContent = heatmapSvg
            });
        }

        Log("Graphs saved.");
    }
}

