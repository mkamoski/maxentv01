@page "/logs"
@inject IExperimentLogRepository LogRepo
@inject IFileDownloadService FileDownload
@inject IJSRuntime JS

<h2>Experiment Logs</h2>

<button @onclick="RefreshAsync">Refresh</button>

@if (_summaries.Count == 0)
{
    <p>No logs saved yet. Run an experiment and click Save Log.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Source</th>
                <th>Saved</th>
                <th>Summary</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in _summaries)
            {
                <tr>
                    <td>@s.Source</td>
                    <td>@Local(s.CreatedAt).ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>
                        @s.Summary
                        @if (s.Status == ExperimentRunStatus.Incomplete)
                        {
                            <span style="background:#dc3545;color:#fff;font-size:10px;padding:1px 5px;border-radius:3px;margin-left:6px;vertical-align:middle;">Incomplete</span>
                        }
                    </td>
                    <td>
                        <button @onclick="() => SelectAsync(s.Id)">View</button>
                        <button @onclick="() => DownloadAsync(s.Id, s.Source, s.CreatedAt)">Download</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (_selected is not null)
{
    <hr />
    <h3>@_selected.Source — @Local(_selected.CreatedAt).ToString("yyyy-MM-dd HH:mm:ss")</h3>
    <pre style="height:400px;overflow-y:auto;background:#111;color:#0f0;padding:8px;white-space:pre-wrap;">@_selected.Content</pre>
    <button @onclick="() => _selected = null">Close</button>
}

@code {
    private List<ExperimentLogSummary> _summaries = [];
    private ExperimentLog? _selected;
    private int _offsetMinutes;

    protected override async Task OnInitializedAsync()
    {
        var module = await JS.InvokeAsync<IJSObjectReference>("import", "./file-download.js");
        _offsetMinutes = await module.InvokeAsync<int>("getBrowserUtcOffsetMinutes");
        await RefreshAsync();
    }

    private DateTime Local(DateTime utc) => utc.AddMinutes(_offsetMinutes);

    private async Task RefreshAsync()
    {
        _summaries = await LogRepo.GetSummariesAsync();
        _selected = null;
    }

    private async Task SelectAsync(Guid id) =>
        _selected = await LogRepo.GetByIdAsync(id);

    private async Task DownloadAsync(Guid id, string source, DateTime createdAt)
    {
        var log = await LogRepo.GetByIdAsync(id);
        if (log is null) return;
        var localTime = Local(createdAt);
        var shortSource = source.Replace("MaxEnt", string.Empty);
        var fileName = $"MaxEnt_{shortSource}_{localTime:yyyy_MM_dd_HHmm_ss_fffff}.csv";
        await FileDownload.DownloadTextAsync(log.Content, fileName);
    }
}
