@page "/logs"
@inject IExperimentLogRepository LogRepo
@inject IFileDownloadService FileDownload
@inject IJSRuntime JS

<h2>Experiment Logs</h2>

<button @onclick="RefreshAsync">Refresh</button>

@if (_summaries.Count == 0)
{
    <p>No logs saved yet. Run an experiment and click Save Log.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th style="cursor:pointer;user-select:none;" @onclick="@(() => SetSort("source"))">
                    Source @SortIndicator("source")
                </th>
                <th style="cursor:pointer;user-select:none;" @onclick="@(() => SetSort("file"))">
                    File @SortIndicator("file")
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Sorted())
            {
                <tr>
                    <td>@s.Source</td>
                    <td><span style="font-family:monospace;font-size:0.85em;">@CsvFileName(s.Source, s.CreatedAt)</span></td>
                    <td>
                        <button @onclick="() => DownloadAsync(s.Id, s.Source, s.CreatedAt)">Download</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<ExperimentLogSummary> _summaries = [];
    private int _offsetMinutes;
    private string _sortColumn = "file";
    private bool _sortAscending = false;

    private void SetSort(string column)
    {
        if (_sortColumn == column)
            _sortAscending = !_sortAscending;
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private string SortIndicator(string column)
    {
        if (_sortColumn != column) return "⇅";
        return _sortAscending ? "▲" : "▼";
    }

    private IEnumerable<ExperimentLogSummary> Sorted() => (_sortColumn, _sortAscending) switch
    {
        ("source", true)  => _summaries.OrderBy(s => s.Source),
        ("source", false) => _summaries.OrderByDescending(s => s.Source),
        ("file",   true)  => _summaries.OrderBy(s => s.CreatedAt),
        _                 => _summaries.OrderByDescending(s => s.CreatedAt),
    };

    protected override async Task OnInitializedAsync()
    {
        var module = await JS.InvokeAsync<IJSObjectReference>("import", "./file-download.js");
        _offsetMinutes = await module.InvokeAsync<int>("getBrowserUtcOffsetMinutes");
        await RefreshAsync();
    }

    private DateTime Local(DateTime utc) => utc.AddMinutes(_offsetMinutes);

    private async Task RefreshAsync()
    {
        _summaries = await LogRepo.GetSummariesAsync();
    }

    private string CsvFileName(string source, DateTime createdAt)
    {
        var localTime = Local(createdAt);
        var shortSource = source.Replace("MaxEnt", string.Empty);
        return $"MaxEnt_{shortSource}_{localTime:yyyy_MM_dd_HHmm_ss_fffff}.csv";
    }

    private async Task DownloadAsync(Guid id, string source, DateTime createdAt)
    {
        var log = await LogRepo.GetByIdAsync(id);
        if (log is null) return;
        await FileDownload.DownloadTextAsync(log.Content, CsvFileName(source, createdAt));
    }
}
