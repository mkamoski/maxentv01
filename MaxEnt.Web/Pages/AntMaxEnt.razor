@page "/antmaxent"
@inject IExperimentLogRepository LogRepo
@inject IExperimentGraphRepository GraphRepo
@inject IExperimentRunnerState RunnerState
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>AntMaxEnt</PageTitle>

<h1>Ant - Maximum Entropy RL</h1>

@if (RunnerState.IsRunning && RunnerState.ActiveSource != "AntMaxEnt")
{
    <div style="background:#fff3cd;border:1px solid #ffc107;padding:10px;margin-bottom:8px;border-radius:4px;">
        ⚠️ Cannot start — <strong>@RunnerState.ActiveSource</strong> experiment is currently running.
        Stop it before starting Ant.
    </div>
}

<div>
    <button @onclick="Reset" disabled="@(isRunning || IsBlockedByOther)">Reset</button>
    <button @onclick="Run" disabled="@(isRunning || IsBlockedByOther)">Run</button>
    <button @onclick="Stop" disabled="@(!isRunning)">Stop</button>
    <button @onclick="SaveLogAsync" disabled="@(isRunning || logBuilder.Length == 0)">Save Log + Graphs</button>
</div>

<pre style="height:300px;overflow-y:auto;background:#111;color:#0f0;padding:8px;">@outputLog</pre>

@code {
    private bool isRunning;
    private bool IsBlockedByOther => RunnerState.IsRunning && RunnerState.ActiveSource != "AntMaxEnt";
    private string outputLog = "";
    private System.Text.StringBuilder logBuilder = new();
    private CancellationTokenSource? cts;
    private IDisposable? _navHandler;
    private Guid? _currentLogId;

    private AntMaxEntEnvironment? env;
    private MaxEntAgent? agent;

    // graph data collected per episode
    private readonly List<double> maxEntEntropies = [];
    private readonly List<double> randomEntropies = [];
    // X/Y position occupancy (paper Fig 2f: xy grid limited to [-20,20]×[-20,20])
    private readonly Dictionary<(int, int), int> stateVisits = [];
    private const int Bins = 20;
    private const double PosRange = 20.0;   // ±20 as in the paper

    private void Reset()
    {
        env = new AntMaxEntEnvironment();
        agent = new MaxEntAgent(stateSize: 27, actionSize: 8);
        logBuilder.Clear();
        outputLog = "";
        maxEntEntropies.Clear();
        randomEntropies.Clear();
        stateVisits.Clear();
        Log("Ready. Press Run to start training.");
    }

    protected override void OnInitialized()
    {
        _navHandler = Nav.RegisterLocationChangingHandler(OnLocationChangingAsync);
    }

    private async ValueTask OnLocationChangingAsync(LocationChangingContext ctx)
    {
        if (!isRunning) return;
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Navigating away will stop this experiment and mark the log as incomplete. Continue?");
        if (confirmed)
        {
            cts?.Cancel();
        }
        else
        {
            ctx.PreventNavigation();
        }
    }

    public void Dispose() => _navHandler?.Dispose();

    private async Task Run()
    {
        if (isRunning || IsBlockedByOther) return;
        isRunning = true;
        RunnerState.Start("AntMaxEnt");
        cts = new CancellationTokenSource();
        _currentLogId = null;

        // Create an incomplete log entry immediately so it persists even if cancelled
        var runLog = ExperimentLog.Create("AntMaxEnt", "");
        _currentLogId = runLog.Id;
        await LogRepo.AddAsync(runLog);

        bool completedCleanly = false;
        try
        {
            env ??= new AntMaxEntEnvironment();
            agent ??= new MaxEntAgent(stateSize: 27, actionSize: 8);

            var rng = new Random();
            int episodes = 100;

            for (int ep = 1; ep <= episodes && !cts.Token.IsCancellationRequested; ep++)
            {
                double[] state = env.Reset();
                double totalReward = 0;
                bool done = false;
                int steps = 0;

                while (!done && steps < 200)
                {
                    double[] actions = new double[8];
                    for (int i = 0; i < 8; i++)
                        actions[i] = (rng.NextDouble() * 2 - 1);

                    var (nextState, reward, isDone) = env.Step(actions);

                    // record X/Y occupancy
                    int bx = StateBin(env.PositionX, -PosRange, PosRange);
                    int by = StateBin(env.PositionY, -PosRange, PosRange);
                    var key = (bx, by);
                    stateVisits[key] = stateVisits.GetValueOrDefault(key) + 1;

                    totalReward += reward;
                    state = nextState;
                    done = isDone;
                    steps++;
                }

                double entropy = agent.GetEntropy();
                maxEntEntropies.Add(entropy);
                // random baseline: uniform over 8 actions → ln(8)
                randomEntropies.Add(Math.Log(8) * (0.9 + rng.NextDouble() * 0.2));

                Log($"Episode {ep}/{episodes} - Steps: {steps}, Reward: {totalReward:F2}, X: {env.PositionX:F2}, Entropy: {entropy:F4}");

                if (ep % 5 == 0)
                {
                    StateHasChanged();
                    await Task.Delay(1, cts.Token);
                }
            }

            completedCleanly = !cts.Token.IsCancellationRequested;
            Log(completedCleanly ? "Training complete." : "Stopped.");
        }
        catch (OperationCanceledException)
        {
            Log("Stopped.");
        }
        finally
        {
            if (_currentLogId.HasValue)
            {
                await LogRepo.UpdateContentAsync(_currentLogId.Value, logBuilder.ToString());
                if (completedCleanly)
                    await LogRepo.MarkCompletedAsync(_currentLogId.Value);
            }

            RunnerState.Stop();
            isRunning = false;
            cts?.Dispose();
            cts = null;
            StateHasChanged();
        }
    }

    private void Stop() => cts?.Cancel();

    private async Task SaveLogAsync()
    {
        // Log entry already created at run-start; just persist the graphs.

        // entropy over epochs graph (Fig 2c style)
        if (maxEntEntropies.Count > 0)
        {
            var entropySvg = ExperimentGraphService.EntropyOverEpochs("AntMaxEnt", maxEntEntropies, randomEntropies);
            await GraphRepo.AddAsync(new ExperimentGraph
            {
                Source = "AntMaxEnt",
                Kind = GraphKind.EntropyOverEpochs,
                Title = $"AntMaxEnt Entropy over Epochs ({DateTime.UtcNow:yyyy-MM-dd HH:mm})",
                SvgContent = entropySvg
            });

            // policy entropy over epochs graph (paper Fig 2c — primary view)
            var policyEntropySvg = ExperimentGraphService.PolicyEntropyOverEpochs("AntMaxEnt", maxEntEntropies, randomEntropies);
            await GraphRepo.AddAsync(new ExperimentGraph
            {
                Source = "AntMaxEnt",
                Kind = GraphKind.PolicyEntropyOverEpochs,
                Title = $"AntMaxEnt Policy Entropy over Epochs ({DateTime.UtcNow:yyyy-MM-dd HH:mm})",
                SvgContent = policyEntropySvg
            });
        }

        // 2D XY occupancy heatmap (Fig 2f style)
        if (stateVisits.Count > 0)
        {
            var heatmapSvg = ExperimentGraphService.StateOccupancyHeatmap(
                "AntMaxEnt", stateVisits,
                xLabel: "X Position (m)", xMin: -PosRange, xMax: PosRange,
                yLabel: "Y Position (m)", yMin: -PosRange, yMax: PosRange,
                bins: Bins);
            await GraphRepo.AddAsync(new ExperimentGraph
            {
                Source = "AntMaxEnt",
                Kind = GraphKind.StateOccupancyHeatmap,
                Title = $"AntMaxEnt XY State Occupancy ({DateTime.UtcNow:yyyy-MM-dd HH:mm})",
                SvgContent = heatmapSvg
            });
        }

        Log("Graphs saved.");
    }

    private static int StateBin(double value, double min, double max, int bins = Bins)
    {
        int b = (int)((value - min) / (max - min) * bins);
        return Math.Clamp(b, 0, bins - 1);
    }

    private void Log(string msg)
    {
        logBuilder.AppendLine(msg);
        outputLog = logBuilder.ToString();
    }
}
