<?xml version="1.0" encoding="utf-8"?>
<!--
  Cross-origin isolation headers re-enable high-resolution performance.now()
  in browsers (Spectre mitigation bypass). Required for sub-millisecond
  timestamp fidelity in Blazor WebAssembly.
-->
<configuration>
  <system.webServer>
	<httpProtocol>
	  <customHeaders>
		<add name="Cross-Origin-Opener-Policy" value="same-origin" />
		<add name="Cross-Origin-Embedder-Policy" value="require-corp" />
	  </customHeaders>
	</httpProtocol>
  </system.webServer>
</configuration>
