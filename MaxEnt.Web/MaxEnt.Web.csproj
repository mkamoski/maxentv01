<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WasmNativeBuild>true</WasmNativeBuild>
    <!-- WASM0001: sqlite3_config uses C varargs which are unsupported in WASM.
         EF Core never calls sqlite3_config at runtime so this is safe to suppress. -->
    <NoWarn>$(NoWarn);WASM0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.7" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.7" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MaxEnt.Logic\MaxEnt.Logic.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="maxent-original-paper-1812.02690v2.pdf">
      <LogicalName>maxent_paper.pdf</LogicalName>
    </None>
  </ItemGroup>

</Project>
